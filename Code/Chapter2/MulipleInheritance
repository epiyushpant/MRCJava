// Animal-themed demonstration: Diamond Problem and solutions in Java
//  - Shows why 'class C extends A, B' is illegal (commented out)
//  - Solution A: Resolve conflicts when implementing multiple interfaces
//  - Solution B: Use composition/delegation instead of multiple class inheritance

// --- Illegal attempt (kept commented) ---
// class AnimalBase { void sound() { System.out.println("AnimalBase sound"); } }
// class DogBase   { void sound() { System.out.println("DogBase bark"); } }
// // Illegal in Java:
// class ProblemAnimal extends AnimalBase, DogBase { }

// --- Solution 1: Interfaces with default methods ---
interface IAnimalA {
	default void sound() {
		System.out.println("IAnimalA: generic animal sound");
	}
}

interface IAnimalB {
	default void sound() {
		System.out.println("IAnimalB: different animal sound");
	}
}

// Class implements both interfaces — compiler forces an explicit override
// to resolve which default method should apply.
class ResolvedAnimal implements IAnimalA, IAnimalB {
	@Override
	public void sound() {
		// Option 1: choose one interface's default
		System.out.print("choose IAnimalA -> ");
		IAnimalA.super.sound();

		// Option 2: choose the other
		System.out.print("choose IAnimalB -> ");
		IAnimalB.super.sound();

		// Option 3: provide a new combined implementation
		System.out.println("ResolvedAnimal: combined behavior");
	}
}

// --- Solution 2: Composition / Delegation ---
class AnimalBehavior {
	void sound() { System.out.println("AnimalBehavior: generic sound"); }
}

class DogBehavior {
	void sound() { System.out.println("DogBehavior: bark"); }
}

class AnimalByComposition {
	private final AnimalBehavior animal = new AnimalBehavior();
	private final DogBehavior dog = new DogBehavior();

	void useAnimal() { animal.sound(); }
	void useDog()    { dog.sound(); }
}

// --- Runner showing both solutions ---
public class MultipleInheritanceDemo {
	public static void main(String[] args) {
		System.out.println("--- Interface-based resolution ---");
		ResolvedAnimal r = new ResolvedAnimal();
		r.sound();

		System.out.println("\n--- Composition-based delegation ---");
		AnimalByComposition comp = new AnimalByComposition();
		System.out.print("delegate to AnimalBehavior -> "); comp.useAnimal();
		System.out.print("delegate to DogBehavior ->    "); comp.useDog();

		System.out.println("\n--- Note ---");
		System.out.println("Java disallows multiple class inheritance to avoid ambiguity (Diamond Problem).");
		System.out.println("Use interfaces with explicit overrides or composition to resolve behavior.");
	}
}

